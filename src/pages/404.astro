---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" isHome={false}>
  <div class="not-found">
    <div class="not-found-code">404</div>
    <h1 class="not-found-title">Page not found</h1>
    <p class="not-found-desc">
      This page doesn't exist — it may have been moved, renamed, or never existed in the first place.
    </p>
    <div class="not-found-actions">
      <a href="/" class="not-found-btn primary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Back to home
      </a>
      <a href="https://github.com/ObscuriaLithium/obscurialithium.github.io/issues" target="_blank" rel="noopener" class="not-found-btn secondary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        Report an issue
      </a>
    </div>
  </div>
</Layout>

<script is:inline>
// Track 404 errors: what URL the user tried to access + referrer
(function () {
  if (typeof gtag !== 'function') return;

  var attemptedUrl = window.location.pathname + window.location.search + window.location.hash;
  var referrer = document.referrer || '(direct)';

  gtag('event', 'page_not_found', {
    event_category: '404_errors',
    event_label: attemptedUrl,
    // Also log where the user came from — broken internal link or external?
    page_referrer: referrer,
    non_interaction: true
  });
})();
</script>

<style>
.not-found {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 60vh;
  padding: var(--space-8) 0;
}
.not-found-code {
  margin-bottom: var(--space-3);
  font-size: 6rem;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.04em;
  color: var(--acc-text);
}
.not-found-title {
  margin: 0 0 var(--space-3);
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--txt-head);
}
.not-found-desc {
  max-width: 420px;
  margin: 0 0 var(--space-6);
  font-size: var(--fs-md);
  line-height: var(--lh-body);
  color: var(--txt-muted);
}
.not-found-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
.not-found-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 0.6em 1.2em;
  border-radius: var(--radius);
  font-size: var(--fs-sm);
  font-weight: 600;
  text-decoration: none;
  transition: background 0.2s var(--ease), color 0.2s var(--ease);
}
.not-found-btn.primary { background: var(--acc); color: var(--on-acc); }
.not-found-btn.primary:hover { background: var(--acc-hover); }
.not-found-btn.secondary { background: var(--surface-2); color: var(--txt); }
.not-found-btn.secondary:hover { background: var(--surface-3); color: var(--txt-head); }
</style>
