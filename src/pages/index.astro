---
import Layout from '../layouts/Layout.astro';
import DownloadBadge from '../components/DownloadBadge.astro';
import PlatformButton from '../components/PlatformButton.astro';
import { MODS, SOCIAL_LINKS } from '../data/mods';

const newRelease  = MODS.find(m => m.isNewRelease);
const featured    = MODS.filter(m => m.tier === 'featured' && !m.isNewRelease);
const major       = MODS.filter(m => m.tier === 'major'    && !m.isNewRelease);
const minor       = MODS.filter(m => m.tier === 'minor');
---

<Layout title="Home" isHome={true}>

<section class="sc-hero" id="sc-hero">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="sc-hero-grid" aria-hidden="true"></div>
  <div class="sc-orb sc-orb-1" aria-hidden="true"></div>
  <div class="sc-orb sc-orb-2" aria-hidden="true"></div>
  <div class="sc-orb sc-orb-3" aria-hidden="true"></div>

  <div class="sc-hero-inner">
    <p class="sc-eyebrow">
      <span class="sc-eyebrow-line"></span>Welcome to<span class="sc-eyebrow-line"></span>
    </p>
    <h1 class="sc-title">
      <span class="sc-title-line">Obscuria</span>
      <span class="sc-title-line sc-title-accent">Collection</span>
    </h1>
    <p class="sc-sub">
      A unified ecosystem of Minecraft mods focused on atmosphere,
      visual polish, and immersive gameplay systems.
    </p>
    <div class="sc-hero-stats">
      <div class="sc-stat">
        <span class="sc-stat-num">{MODS.length}</span>
        <span class="sc-stat-label">mods</span>
      </div>
      <div class="sc-stat-sep"></div>
      <div class="sc-stat">
        <DownloadBadge sources={MODS.flatMap(m => m.sources)} compact={true} />
        <span class="sc-stat-label">total downloads</span>
      </div>
      <div class="sc-stat-sep"></div>
      <div class="sc-stat">
        <span class="sc-stat-num">CF+MR</span>
        <span class="sc-stat-label">platforms</span>
      </div>
    </div>
    <div class="sc-hero-cta">
      <a href="#showcase" class="sc-btn sc-btn-primary">
        <span>Explore mods</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </a>
      <a href={SOCIAL_LINKS.discord} target="_blank" rel="noopener" class="sc-btn sc-btn-ghost">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Discord
      </a>
    </div>
  </div>

  <div class="sc-scroll-hint" aria-hidden="true"><span></span></div>
</section>


{newRelease && (
<section class="sc-new-release" id="showcase">
  <div class="sc-nr-tag">
    <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
    New Release
  </div>
  <div class="sc-nr-body">
    <div class="sc-nr-cover">
      {newRelease.cover
        ? <img src={newRelease.cover} alt={newRelease.name} loading="eager" />
        : <div class="sc-nr-cover-placeholder"><img src={newRelease.icon} alt="" class="sc-nr-cover-icon" /></div>
      }
      <div class="sc-nr-cover-shimmer"></div>
    </div>
    <div class="sc-nr-info">
      <div class="sc-nr-meta">
        {newRelease.loaders.map(l => <span class={`sc-loader sc-loader-${l}`}>{l}</span>)}
        <span class="sc-nr-date">{new Date(newRelease.releaseDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
      </div>
      <img src={newRelease.icon} alt="" class="sc-nr-icon" aria-hidden="true" />
      <h2 class="sc-nr-title">{newRelease.name}</h2>
      <p class="sc-nr-tagline">{newRelease.tagline}</p>
      <p class="sc-nr-desc">{newRelease.description}</p>
      <div class="sc-nr-downloads"><DownloadBadge sources={newRelease.sources} /></div>
      <div class="sc-nr-actions">
        {newRelease.docsSlug && (
          <a href={`/docs/${newRelease.docsSlug}`} class="sc-btn sc-btn-primary">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            View Docs
          </a>
        )}
        <PlatformButton sources={newRelease.sources} size="normal" />
      </div>
    </div>
  </div>
</section>
)}


<section class="sc-showcase" id={!newRelease ? 'showcase' : undefined}>
  <div class="sc-toolbar">
    <div class="sc-toolbar-left">
      <p class="sc-section-label">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        All Mods
      </p>
      <div class="sc-filter-group" role="group" aria-label="Filter by platform">
        <button class="sc-filter active" data-filter="all">All</button>
        <button class="sc-filter" data-filter="curseforge"><span class="sc-filter-dot cf"></span>CurseForge</button>
        <button class="sc-filter" data-filter="modrinth"><span class="sc-filter-dot mr"></span>Modrinth</button>
        <button class="sc-filter" data-filter="fabric">Fabric</button>
        <button class="sc-filter" data-filter="forge">Forge</button>
        <button class="sc-filter" data-filter="neoforge">NeoForge</button>
      </div>
    </div>
    <div class="sc-sort-wrap">
      <label for="sc-sort" class="sc-sort-label">Sort</label>
      <select id="sc-sort" class="sc-sort">
        <option value="default">Default</option>
        <option value="downloads">Downloads</option>
        <option value="date-desc">Newest first</option>
        <option value="date-asc">Oldest first</option>
        <option value="name">Name A-Z</option>
      </select>
    </div>
  </div>

  <div class="sc-grid" id="sc-grid">

    {[...featured, ...major].map(mod => (
      <article
        class={`sc-card sc-card-major ${mod.tier === 'featured' ? 'sc-card-featured' : ''}`}
        data-mod-id={mod.id}
        data-loaders={mod.loaders.join(',')}
        data-platforms={mod.sources.map(s => s.platform).join(',')}
        data-date={mod.releaseDate}
        data-tier={mod.tier}
        data-reveal
      >
        <div class="sc-card-media">
          {mod.cover
            ? <img src={mod.cover} alt={`${mod.name} cover`} class="sc-card-cover" loading="lazy" />
            : <div class="sc-card-cover-ph"><img src={mod.icon} alt="" class="sc-card-ph-icon" /></div>
          }
          {mod.gallery && mod.gallery.length > 0 && (
            <div class="sc-gallery-strip">
              {mod.gallery.slice(0,3).map(img => (
                <img src={img.src} alt={img.alt} class="sc-gallery-thumb" loading="lazy" />
              ))}
            </div>
          )}
          <div class="sc-card-media-overlay"></div>
          <div class="sc-card-dl-overlay">
            <DownloadBadge sources={mod.sources} compact={true} />
          </div>
        </div>
        <div class="sc-card-body">
          <div class="sc-card-header">
            <img src={mod.icon} alt="" class="sc-card-icon" loading="lazy" />
            <div class="sc-card-titles">
              <h3 class="sc-card-name">
                {mod.name}
                {mod.isBeta  && <span class="sc-status beta">beta</span>}
                {mod.isAlpha && <span class="sc-status alpha">alpha</span>}
              </h3>
              <p class="sc-card-tagline">{mod.tagline}</p>
            </div>
          </div>
          <p class="sc-card-desc">{mod.description}</p>
          <div class="sc-card-meta">
            {mod.loaders.map(l => <span class={`sc-loader sc-loader-${l}`}>{l}</span>)}
            {mod.tags?.slice(0,3).map(t => <span class="sc-tag">{t}</span>)}
          </div>
          <div class="sc-card-downloads"><DownloadBadge sources={mod.sources} /></div>
          <div class="sc-card-actions">
            {mod.docsSlug && (
              <a href={`/docs/${mod.docsSlug}`} class="sc-btn sc-btn-sm sc-btn-docs">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                Docs
              </a>
            )}
            <PlatformButton sources={mod.sources} size="sm" />
          </div>
        </div>
      </article>
    ))}

    {minor.map(mod => (
      <article
        class="sc-card sc-card-minor"
        data-mod-id={mod.id}
        data-loaders={mod.loaders.join(',')}
        data-platforms={mod.sources.map(s => s.platform).join(',')}
        data-date={mod.releaseDate}
        data-tier="minor"
        data-reveal
      >
        <div class="sc-card-minor-glow"></div>
        <img src={mod.icon} alt={mod.name} class="sc-card-minor-icon" loading="lazy" />
        <div class="sc-card-minor-body">
          <h3 class="sc-card-minor-name">
            {mod.name}
            {mod.isBeta  && <span class="sc-status beta">beta</span>}
            {mod.isAlpha && <span class="sc-status alpha">alpha</span>}
          </h3>
          <p class="sc-card-minor-desc">{mod.tagline}</p>
          <div class="sc-card-minor-foot">
            <div class="sc-card-minor-loaders">
              {mod.loaders.map(l => <span class={`sc-loader sc-loader-${l}`}>{l}</span>)}
            </div>
            <DownloadBadge sources={mod.sources} compact={true} />
          </div>
        </div>
        <div class="sc-card-minor-actions">
          {mod.docsSlug && (
            <a href={`/docs/${mod.docsSlug}`} class="sc-card-minor-action" title="Docs">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </a>
          )}
          <PlatformButton sources={mod.sources} iconOnly={true} />
        </div>
      </article>
    ))}

  </div>

  <div class="sc-empty" id="sc-empty" hidden>
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    <p>No mods match the current filter.</p>
    <button class="sc-btn sc-btn-ghost sc-reset-filter">Clear filter</button>
  </div>
</section>


<section class="sc-collab" id="collaboration">
  <div class="sc-collab-bg"></div>
  <div class="sc-collab-inner" data-reveal>
    <p class="sc-section-label">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Collaboration
    </p>
    <h2 class="sc-collab-title">One project — one artist.</h2>
    <p class="sc-collab-text">
      While most projects are developed independently, a dedicated collaboration format exists.
      Each collaboration is a close creative partnership — I fully manage the codebase, architecture,
      multi-version support and cross-loader maintenance, while the artist owns the complete visual
      direction. Revenue is shared <strong>50/50</strong>.
    </p>
    <p class="sc-collab-text">
      This applies to new concepts developed together, or existing mods — in the latter case I can
      take over active development while the original author retains creative credit and 50% revenue share.
    </p>
    <a href={SOCIAL_LINKS.discord} target="_blank" rel="noopener" class="sc-btn sc-btn-primary">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Reach out on Discord
    </a>
  </div>
</section>


<footer class="sc-footer">
  <div class="sc-footer-inner">
    <div class="sc-footer-brand">
      <p class="sc-footer-name">Obscuria Collection</p>
      <p class="sc-footer-desc">
        A unified ecosystem of Minecraft mods focused on atmosphere, visual polish, and immersive gameplay systems.
      </p>
      <div class="sc-footer-socials">
        <a href={SOCIAL_LINKS.discord}    target="_blank" rel="noopener" aria-label="Discord">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </a>
        <a href={SOCIAL_LINKS.curseforge} target="_blank" rel="noopener" aria-label="CurseForge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
        </a>
        <a href={SOCIAL_LINKS.modrinth}   target="_blank" rel="noopener" aria-label="Modrinth">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6a6 6 0 0 1 0 12"/></svg>
        </a>
        <a href={SOCIAL_LINKS.github}     target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
        </a>
        <a href={SOCIAL_LINKS.email} aria-label="Email">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </a>
      </div>
    </div>
    <nav class="sc-footer-nav">
      <div class="sc-footer-col">
        <p class="sc-footer-col-title">Docs</p>
        {MODS.filter(m => m.docsSlug).map(m => (
          <a href={`/docs/${m.docsSlug}`} class="sc-footer-link">{m.name}</a>
        ))}
      </div>
      <div class="sc-footer-col">
        <p class="sc-footer-col-title">Platforms</p>
        <a href={SOCIAL_LINKS.curseforge} target="_blank" rel="noopener" class="sc-footer-link">CurseForge</a>
        <a href={SOCIAL_LINKS.modrinth}   target="_blank" rel="noopener" class="sc-footer-link">Modrinth</a>
        <a href={SOCIAL_LINKS.github}     target="_blank" rel="noopener" class="sc-footer-link">GitHub</a>
      </div>
      <div class="sc-footer-col">
        <p class="sc-footer-col-title">Legal</p>
        <a href={SOCIAL_LINKS.email} class="sc-footer-link">Contact</a>
      </div>
    </nav>
  </div>
  <div class="sc-footer-bottom">
    <p>&#169; {new Date().getFullYear()} ObscuriaLithium. All rights reserved.</p>
    <p class="sc-footer-made">Built with Astro</p>
  </div>
</footer>

</Layout>


<script>
(function () {
  // ── Particle canvas ──────────────────────────────────────────────────────
  const canvas = document.getElementById('hero-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const COLORS = ['#a87fd4','#7a8ee0','#c8a8f0','#6e7cd8'];
  let W = 0, H = 0;
  const particles = [];

  function resize() {
    const hero = document.getElementById('sc-hero');
    W = canvas.width  = hero.offsetWidth;
    H = canvas.height = hero.offsetHeight;
  }

  function spawn() {
    return {
      x: Math.random()*W, y: Math.random()*H,
      vx: (Math.random()-0.5)*0.35, vy: (Math.random()-0.5)*0.25-0.08,
      r: Math.random()*1.8+0.5,
      alpha: Math.random()*0.6+0.1, da: (Math.random()-0.5)*0.003,
      color: COLORS[Math.floor(Math.random()*COLORS.length)]
    };
  }

  resize();
  for (let i=0;i<120;i++) particles.push(spawn());
  window.addEventListener('resize', resize);

  function draw() {
    ctx.clearRect(0,0,W,H);
    for (const p of particles) {
      p.x+=p.vx; p.y+=p.vy; p.alpha+=p.da;
      if (p.alpha<=0||p.alpha>0.75) p.da*=-1;
      if (p.y<-10||p.x<-10||p.x>W+10) { p.x=Math.random()*W; p.y=H+5; p.vx=(Math.random()-0.5)*0.35; p.vy=-Math.random()*0.4-0.08; }
      ctx.save();
      ctx.globalAlpha = Math.max(0,Math.min(1,p.alpha));
      ctx.fillStyle = p.color;
      ctx.shadowBlur=6; ctx.shadowColor=p.color;
      ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2); ctx.fill();
      ctx.restore();
    }
    requestAnimationFrame(draw);
  }
  draw();
})();

// ── Scroll reveal ────────────────────────────────────────────────────────────
(function(){
  const DELAYS=['0ms','80ms','160ms','240ms','320ms'];
  const io=new IntersectionObserver(entries=>{
    entries.forEach(e=>{
      if(e.isIntersecting){
        const el=e.target;
        el.style.transitionDelay=el.dataset.revealDelay?DELAYS[+el.dataset.revealDelay]||'0ms':'0ms';
        el.classList.add('sc-revealed');
        io.unobserve(el);
      }
    });
  },{threshold:0.07,rootMargin:'0px 0px -30px 0px'});
  document.querySelectorAll('[data-reveal]').forEach(el=>io.observe(el));
})();

// ── Filter + Sort ────────────────────────────────────────────────────────────
(function(){
  const grid=document.getElementById('sc-grid');
  const empty=document.getElementById('sc-empty');
  const sortEl=document.getElementById('sc-sort');
  const filterBtns=document.querySelectorAll('.sc-filter');
  const resetBtns=document.querySelectorAll('.sc-reset-filter');
  let activeFilter='all';

  function applyFilter(f){
    activeFilter=f;
    filterBtns.forEach(b=>b.classList.toggle('active',b.dataset.filter===f));
    const cards=Array.from(grid.querySelectorAll('.sc-card'));
    let visible=0;
    cards.forEach(c=>{
      const pl=(c.dataset.platforms||'').split(',');
      const lo=(c.dataset.loaders||'').split(',');
      const ok=f==='all'||pl.includes(f)||lo.includes(f);
      c.style.display=ok?'':'none';
      if(ok)visible++;
    });
    if(empty) empty.hidden=visible>0;
  }

  function applySort(v){
    const cards=Array.from(grid.querySelectorAll('.sc-card'));
    const TIER={featured:0,major:1,minor:2};
    cards.sort((a,b)=>{
      if(v==='date-desc')return(b.dataset.date||'')>(a.dataset.date||'')?1:-1;
      if(v==='date-asc') return(a.dataset.date||'')>(b.dataset.date||'')?1:-1;
      if(v==='name'){
        const na=a.querySelector('.sc-card-name,.sc-card-minor-name')?.textContent?.trim()||'';
        const nb=b.querySelector('.sc-card-name,.sc-card-minor-name')?.textContent?.trim()||'';
        return na.localeCompare(nb);
      }
      if(v==='downloads'){
        const parse=el=>{
          const t=el.querySelector('.dl-compact')?.textContent?.trim()||'0';
          const n=parseFloat(t);
          return t.endsWith('M')?n*1e6:t.endsWith('K')?n*1e3:n;
        };
        return parse(b)-parse(a);
      }
      const ta=TIER[a.dataset.tier]??2, tb=TIER[b.dataset.tier]??2;
      if(ta!==tb)return ta-tb;
      return(b.dataset.date||'')>(a.dataset.date||'')?1:-1;
    });
    cards.forEach(c=>grid.appendChild(c));
  }

  filterBtns.forEach(b=>b.addEventListener('click',()=>applyFilter(b.dataset.filter)));
  resetBtns.forEach(b=>b.addEventListener('click',()=>applyFilter('all')));
  sortEl?.addEventListener('change',()=>applySort(sortEl.value));
})();

// ── Parallax orbs ────────────────────────────────────────────────────────────
(function(){
  let raf=0;
  const orbs=document.querySelectorAll('.sc-orb');
  window.addEventListener('scroll',()=>{
    cancelAnimationFrame(raf);
    raf=requestAnimationFrame(()=>{
      const y=window.scrollY;
      orbs.forEach((o,i)=>{ o.style.transform=`translateY(${y*[0.15,0.25,0.1][i]}px)`; });
    });
  },{passive:true});
})();

// ── Card cursor glow ─────────────────────────────────────────────────────────
(function(){
  document.querySelectorAll('.sc-card-major').forEach(card=>{
    card.addEventListener('mousemove',e=>{
      const r=card.getBoundingClientRect();
      const x=((e.clientX-r.left)/r.width*100).toFixed(1);
      const y=((e.clientY-r.top)/r.height*100).toFixed(1);
      card.style.setProperty('--mx',x+'%');
      card.style.setProperty('--my',y+'%');
    });
  });
})();
</script>


<style>
/* ── Shared tokens ─────────────────────────────────────────────────────────── */
.sc-section-label{display:inline-flex;align-items:center;gap:.45rem;font-size:.67rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--acc);opacity:.9;margin-bottom:.5rem}
