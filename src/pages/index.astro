---
import Layout from '../layouts/Layout.astro';
import DownloadBadge from '../components/DownloadBadge.astro';
import PlatformButton from '../components/PlatformButton.astro';
import Contributors from '../components/Contributors.astro';
import BlockBackground from '../components/BlockBackground.astro';
import FloatingProp from '../components/FloatingProp.astro';
import ModSpotlight from '../components/ModSpotlight.astro';
import { MODS, SOCIAL_LINKS } from '../data/mods';
import { HOME_ART } from '../data/home-art';
import { SHOWCASE, showcaseMods } from '../data/showcase';

function youtubeId(url: string): string | null {
  const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/))([\w-]{11})/);
  return m ? m[1] : null;
}

function isYoutube(url?: string): boolean {
  return !!url && !!(url.includes('youtube.com') || url.includes('youtu.be'));
}

function fmtDate(d: string): string {
  return new Date(d).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}

const newRelease  = MODS.find(m => m.isNewRelease);
const TIER_ORDER  = { featured: 0, major: 1, minor: 2 } as const;
const allSorted   = [...MODS].sort((a, b) => TIER_ORDER[a.tier] - TIER_ORDER[b.tier]);

const modDataJson = JSON.stringify(MODS.map(m => ({
  id: m.id,
  name: m.name,
  tagline: m.tagline,
  icon: m.icon,
  sources: m.sources,
  loaders: m.loaders,
  releaseDate: m.releaseDate,
  tier: m.tier,
  docsSlug: m.docsSlug ?? null,
  isBeta: m.isBeta ?? false,
  isAlpha: m.isAlpha ?? false,
  isNewRelease: m.isNewRelease ?? false,
})));
---

<Layout title="Home" isHome={true}>

<!-- ============ HERO ============ -->
<section class="ob-hero" id="ob-hero">
  <div class="ob-hero-wash" aria-hidden="true"></div>
  <canvas class="ob-hero-magic" aria-hidden="true"></canvas>

  <div class="ob-hero-inner">
    <div class="ob-hero-head">
      {HOME_ART.hero.logo && (
        <img src={HOME_ART.hero.logo} alt="" class="ob-hero-logo" data-reveal data-reveal-dir="fade" />
      )}
      <div class="ob-hero-titles">
        <p class="sc-eyebrow" data-reveal data-reveal-dir="fade">Welcome to</p>
        <h1 class="sc-title" data-reveal data-reveal-dir="fade" data-reveal-delay="1">
          <span class="sc-title-line">Obscuria</span>
          <span class="sc-title-line sc-title-accent">Collection</span>
        </h1>
      </div>
    </div>
    <p class="sc-sub" data-reveal data-reveal-dir="fade" data-reveal-delay="2">
      Building immersive Minecraft experiences, one detail at a time.
      Cross&#8209;version and cross&#8209;loader mods with extensive in-game configs,
      backed by an active Discord community.
    </p>

    <div class="sc-hero-stats" data-reveal data-reveal-dir="fade" data-reveal-delay="3">
      <div class="sc-stat">
        <span class="sc-stat-num">{MODS.length}</span>
        <span class="sc-stat-label">mods</span>
      </div>
      <div class="sc-stat-sep"></div>
{(() => {
  const allSources = MODS.flatMap(m => m.sources);
  const cfIds = allSources.filter(s => s.platform === 'curseforge').map(s => s.id).join(',');
  const mrIds = allSources.filter(s => s.platform === 'modrinth').map(s => s.id).join(',');
  return (
    <div class="sc-stat">
      <div class="sc-stat-dl-wrap">
        <svg class="sc-stat-dl-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        <span class="sc-stat-num sc-stat-dl" data-cf={cfIds} data-mr={mrIds}>—</span>
      </div>
      <span class="sc-stat-label">total downloads</span>
    </div>
  );
})()}
      <div class="sc-stat-sep"></div>
      <div class="sc-stat">
        <div class="sc-stat-dl-wrap">
          <svg class="sc-stat-dl-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span class="sc-stat-num sc-stat-dl" id="sc-contrib-stat-num">—</span>
        </div>
        <span class="sc-stat-label">contributors</span>
      </div>
      <div class="sc-stat-sep"></div>
      <div class="sc-stat">
        <div class="sc-stat-platforms">
          <a href="https://www.curseforge.com/members/obscuria/projects" target="_blank" rel="noopener" class="sc-platform-pill sc-platform-cf" aria-label="CurseForge">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m6.307 5.581.391 1.675H0s.112.502.167.558c.168.279.335.614.559.837 1.06 1.228 2.902 1.73 4.409 2.009 1.06.224 2.121.28 3.181.335l1.228 3.293h.67l.391 1.061h-.558l-.949 3.07h9.321l-.949-3.07h-.558l.39-1.061h.67s.558-3.404 2.288-4.967C21.935 7.758 24 7.535 24 7.535V5.581H6.307zm9.377 8.428c-.447.279-.949.279-1.284.503-.223.111-.335.446-.335.446-.223-.502-.502-.67-.837-.781-.335-.112-.949-.056-1.786-.782-.558-.502-.614-1.172-.558-1.507v-.167c0-.056 0-.112.056-.168.111-.334.39-.669.948-.893 0 0-.39.559 0 1.117.224.335.67.502 1.061.279.167-.112.279-.335.335-.503.111-.39.111-.781-.224-1.06-.502-.446-.613-1.06-.279-1.451 0 0 .112.502.614.446.335 0 .335-.111.224-.223-.056-.167-.782-1.228.279-2.009 0 0 .669-.447 1.451-.391-.447.056-.949.335-1.116.782v.055c-.168.447-.056.949.279 1.396.223.335.502.614.614 1.06-.168-.056-.279 0-.391.112a.533.533 0 0 0-.112.502c.056.112.168.223.279.223h.168c.167-.055.279-.279.223-.446.112.111.167.391.112.558 0 .167-.112.335-.168.446-.056.112-.167.224-.223.335-.056.112-.112.224-.112.335 0 .112 0 .279.056.391.223.335.67 0 .782-.279.167-.335.111-.726-.112-1.061 0 0 .391.224.67 1.005.223.67-.168 1.451-.614 1.73z"/></svg>
            CurseForge
          </a>
          <a href="https://modrinth.com/user/Obscuria" target="_blank" rel="noopener" class="sc-platform-pill sc-platform-mr" aria-label="Modrinth">
            <svg width="13" height="13" viewBox="0 0 512 514" fill="currentColor" aria-hidden="true"><path d="M503.16,323.56C514.55,281.47 515.32,235.91 503.2,190.76C466.57,54.23 326.04,-26.8 189.33,9.78C83.81,38.02 11.39,128.07 0.69,230.47L43.99,230.47C54.29,147.33 113.74,74.73 199.75,51.71C306.05,23.26 415.13,80.67 453.17,181.38L411.03,192.65C391.64,145.8 352.57,111.45 306.3,96.82L298.56,140.66C335.09,154.13 364.72,184.5 375.56,224.91C391.36,283.8 361.94,344.14 308.56,369.17L320.09,412.16C390.25,383.21 432.4,310.3 422.43,235.14L464.41,223.91C468.816,251.936 467.503,280.565 460.55,308.07L503.16,323.56Z"/><path d="M321.99,504.22C185.27,540.8 44.75,459.77 8.11,323.24C3.911,307.604 1.196,291.606 -0,275.46L43.27,275.46C44.36,287.37 46.47,299.35 49.68,311.29C53.04,323.8 57.45,335.75 62.79,347.07L101.38,323.92C98.13,316.42 95.39,308.6 93.21,300.47C69.17,210.87 122.41,118.77 212.13,94.76C229.13,90.21 246.23,88.44 262.93,89.15L255.19,133C244.73,133.05 234.11,134.42 223.53,137.25C157.31,154.98 118.01,222.95 135.75,289.09C136.85,293.16 138.13,297.13 139.59,300.99L188.94,271.38L174.07,231.95L220.67,184.08L279.57,171.39L296.62,192.38L269.47,219.88L245.79,227.33L228.87,244.72L237.16,267.79C237.16,267.79 253.95,285.63 253.98,285.64L277.7,279.33L294.58,260.79L331.44,249.12L342.42,273.82L304.39,320.45L240.66,340.63L212.08,308.81L162.26,338.7C187.8,367.78 226.2,383.93 266.01,380.56L277.54,423.55C218.13,431.41 160.1,406.82 124.05,361.64L85.64,384.68C136.25,451.17 223.84,484.11 309.61,461.16C371.35,444.64 419.4,402.56 445.42,349.38L488.06,364.88C457.17,431.16 398.22,483.82 321.99,504.22"/></svg>
            Modrinth
          </a>
        </div>
        <span class="sc-stat-label">platforms</span>
      </div>
    </div>

    <div class="sc-hero-cta" data-reveal data-reveal-dir="fade" data-reveal-delay="4">
      <a href="#ob-tabs" class="btn btn-primary">
        <span>Explore</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </a>
      <a href={SOCIAL_LINKS.discord} target="_blank" rel="noopener" class="btn btn-ghost" id="discord-btn">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.59 5.88997C17.36 5.31997 16.05 4.89997 14.67 4.65997C14.5 4.95997 14.3 5.36997 14.17 5.69997C12.71 5.47997 11.26 5.47997 9.83001 5.69997C9.69001 5.36997 9.49001 4.95997 9.32001 4.65997C7.94001 4.89997 6.63001 5.31997 5.40001 5.88997C2.92001 9.62997 2.25001 13.28 2.58001 16.87C4.23001 18.1 5.82001 18.84 7.39001 19.33C7.78001 18.8 8.12001 18.23 8.42001 17.64C7.85001 17.43 7.31001 17.16 6.80001 16.85C6.94001 16.75 7.07001 16.64 7.20001 16.54C10.33 18 13.72 18 16.81 16.54C16.94 16.65 17.07 16.75 17.21 16.85C16.7 17.16 16.15 17.42 15.59 17.64C15.89 18.23 16.23 18.8 16.62 19.33C18.19 18.84 19.79 18.1 21.43 16.87C21.82 12.7 20.76 9.08997 18.61 5.88997H18.59ZM8.84001 14.67C7.90001 14.67 7.13001 13.8 7.13001 12.73C7.13001 11.66 7.88001 10.79 8.84001 10.79C9.80001 10.79 10.56 11.66 10.55 12.73C10.55 13.79 9.80001 14.67 8.84001 14.67ZM15.15 14.67C14.21 14.67 13.44 13.8 13.44 12.73C13.44 11.66 14.19 10.79 15.15 10.79C16.11 10.79 16.87 11.66 16.86 12.73C16.86 13.79 16.11 14.67 15.15 14.67Z"/></svg>
        Discord
        <span class="sc-discord-count" id="discord-online-count" aria-label="members">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </span>
      </a>
    </div>
  </div>
</section>


<!-- ============ TAB NAVIGATION ============ -->
<nav class="ob-tabs" id="ob-tabs" aria-label="Home sections">
  <button class="ob-tab active" data-tab="showcase" type="button" aria-selected="true">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3z"/></svg>
    Showcase
  </button>
  <!-- <button class="ob-tab" data-tab="featured" type="button" aria-selected="false">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
    New Release
  </button> -->
  <button class="ob-tab" data-tab="mods" type="button" aria-selected="false">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="9" x2="9" y2="21"/></svg>
    All Projects
  </button>
  <button class="ob-tab" data-tab="collab" type="button" aria-selected="false">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    Contributors &amp; Collab
  </button>
</nav>


<!-- ============ PANEL: SHOWCASE ============ -->
<section class="ob-panel" id="panel-showcase" data-panel="showcase">

  <ModSpotlight mod={showcaseMods.featured} variant="featured" />
  <ModSpotlight mod={showcaseMods.newRelease} variant="featured" />

  <div class="ob-block ob-block-fill">
    <div class="ob-block-inner ob-block-inner--center" data-reveal data-reveal-dir="fade">
      <p class="sc-section-label">{SHOWCASE.trio.eyebrow}</p>
      <h2 class="ob-block-title">{SHOWCASE.trio.title}</h2>
      <div class="ob-feature-list">
        {showcaseMods.trio.map((mod, i) => (
          <a href={mod.docsSlug ? `/docs/${mod.docsSlug}` : mod.sources[0]?.url} class="ob-feature" data-reveal data-reveal-dir="fade" data-reveal-delay={i + 1}>
            <img src={mod.icon} alt="" class="ob-feature-icon" loading="lazy" />
            <div>
              <h3>{mod.name}</h3>
              <p>{mod.tagline}</p>
            </div>
            <div class="ob-feature-badges">
              {mod.loaders.map(l => <span class={`sc-loader sc-loader-${l}`}>{l}</span>)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <ModSpotlight mod={showcaseMods.mainMod} />

</section>


<!-- ============ PANEL: FEATURED / NEW RELEASE ============ -->
<section class="ob-panel" id="panel-featured" data-panel="featured" hidden>
{newRelease ? (
  <>
  <div class="ob-block ob-block-image">
    <BlockBackground src={HOME_ART.newRelease.background} tint="lilac" />
    <FloatingProp src={HOME_ART.newRelease.prop} placement="top-right" />

    <div class="ob-block-inner" data-reveal data-reveal-dir="fade">
      <div class="sc-nr-tag">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        New Release
      </div>
      <div class="sc-nr-meta">
        {newRelease.loaders.map(l => <span class={`sc-loader sc-loader-${l}`}>{l}</span>)}
        <span class="sc-nr-date">{fmtDate(newRelease.releaseDate)}</span>
      </div>
      <h2 class="ob-block-title">{newRelease.name}</h2>
      <p class="ob-block-tagline">{newRelease.tagline}</p>
      <p class="ob-block-text">{newRelease.description}</p>
      <div class="sc-nr-downloads"><DownloadBadge sources={newRelease.sources} /></div>
      <div class="ob-block-actions">
        {newRelease.docsSlug && (
          <a href={`/docs/${newRelease.docsSlug}`} class="btn btn-primary">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            View Docs
          </a>
        )}
        <PlatformButton sources={newRelease.sources} size="normal" />
      </div>
    </div>
  </div>

  {newRelease.cover && isYoutube(newRelease.cover) && (
    <div class="ob-block ob-block-fill">
      <div class="ob-block-inner ob-block-inner--center" data-reveal data-reveal-dir="fade">
        <p class="sc-section-label">Trailer</p>
        <div class="ob-video-wrap">
          <iframe
            class="ob-video"
            src={`https://www.youtube.com/embed/${youtubeId(newRelease.cover)}?rel=0&modestbranding=1`}
            title={`${newRelease.name} trailer`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </div>
  )}
  </>
) : (
  <div class="ob-block ob-block-fill">
    <div class="ob-block-inner ob-block-inner--center" data-reveal data-reveal-dir="fade">
      <p class="sc-section-label">New Release</p>
      <h2 class="ob-block-title">Nothing new right now — check back soon.</h2>
      <p class="ob-block-text">In the meantime, browse everything the collection already has to offer.</p>
      <div class="ob-block-actions">
        <a href="#ob-tabs" class="btn btn-primary" data-tab-link="mods">Browse all projects</a>
      </div>
    </div>
  </div>
)}
</section>


<!-- ============ PANEL: ALL PROJECTS (table) ============ -->
<section class="ob-panel" id="panel-mods" data-panel="mods" hidden>
  <div class="ob-block ob-block-fill ob-block-flush">
    <div class="ob-block-inner ob-block-inner--wide">

      <div class="sc-toolbar">
        <div class="sc-toolbar-left">
          <p class="sc-section-label">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            All Mods
          </p>
          <div class="sc-filter-group" role="group" aria-label="Filter by platform">
            <button class="sc-filter active" data-filter="all">All</button>
            <button class="sc-filter" data-filter="curseforge"><span class="sc-filter-dot cf"></span>CurseForge</button>
            <button class="sc-filter" data-filter="modrinth"><span class="sc-filter-dot mr"></span>Modrinth</button>
            <button class="sc-filter" data-filter="fabric">Fabric</button>
            <button class="sc-filter" data-filter="forge">Forge</button>
            <button class="sc-filter" data-filter="neoforge">NeoForge</button>
          </div>
        </div>
        <div class="sc-sort-wrap">
          <label for="sc-sort" class="sc-sort-label">Sort</label>
          <select id="sc-sort" class="sc-sort">
            <option value="default">Tier</option>
            <option value="downloads">Downloads</option>
            <option value="date-desc">Newest first</option>
            <option value="date-asc">Oldest first</option>
            <option value="name">Name A-Z</option>
          </select>
        </div>
      </div>

      <div class="ob-table-wrap">
        <table class="ob-table" id="ob-mods-table">
          <thead>
            <tr>
              <th class="ob-th-mod">Mod</th>
              <th class="ob-th-loaders">Loaders</th>
              <th class="ob-th-date">Released</th>
              <th class="ob-th-dl">Downloads</th>
              <th class="ob-th-actions"></th>
            </tr>
          </thead>
          <tbody id="ob-mods-tbody">
            {allSorted.map(mod => (
              <tr
                data-mod-id={mod.id}
                data-loaders={mod.loaders.join(',')}
                data-platforms={mod.sources.map(s => s.platform).join(',')}
                data-date={mod.releaseDate}
                data-tier={mod.tier}
              >
                <td class="ob-td-mod">
                  <img src={mod.icon} alt="" class="ob-td-icon" loading="lazy" />
                  <div class="ob-td-mod-info">
                    <span class="ob-td-name">
                      {mod.name}
                      {mod.tier === 'featured' && <span class="sc-tag ob-tag-featured">featured</span>}
                      {mod.isBeta  && <span class="sc-status beta">beta</span>}
                      {mod.isAlpha && <span class="sc-status alpha">alpha</span>}
                    </span>
                    <span class="ob-td-tagline">{mod.tagline}</span>
                  </div>
                </td>
                <td class="ob-td-loaders">
                  {mod.loaders.map(l => <span class={`sc-loader sc-loader-${l}`}>{l}</span>)}
                </td>
                <td class="ob-td-date">{fmtDate(mod.releaseDate)}</td>
                <td class="ob-td-dl"><DownloadBadge sources={mod.sources} compact={true} /></td>
                <td class="ob-td-actions">
                  {mod.docsSlug && (
                    <a href={`/docs/${mod.docsSlug}`} class="sc-card-minor-action" title="Docs">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                    </a>
                  )}
                  <PlatformButton sources={mod.sources} iconOnly={true} />
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="sc-empty" id="sc-empty" hidden>
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
