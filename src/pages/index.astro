<script>
// ---------------------------------------------------------------
// Tabs
// ---------------------------------------------------------------
(function () {
  const tabs   = Array.from(document.querySelectorAll<HTMLButtonElement>('.ob-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.ob-panel'));
  if (!tabs.length) return;

  function activate(name: string, updateHash = true) {
    tabs.forEach(t => {
      const on = t.dataset.tab === name;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    panels.forEach(p => {
      p.hidden = p.dataset.panel !== name;
    });
    if (updateHash) history.replaceState(null, '', `#tab-${name}`);
    // Tab content should just be visible once you switch to it — don't make
    // people scroll a freshly-opened tab to "discover" it via the scroll animation.
    document.querySelectorAll(`.ob-panel[data-panel="${name}"] [data-reveal]:not(.sc-revealed)`).forEach(el => {
      (el as HTMLElement).style.transitionDelay = '0ms';
      el.classList.add('sc-revealed');
      (window as any).__obUnobserve?.(el as HTMLElement);
    });
  }

  tabs.forEach(t => t.addEventListener('click', () => activate(t.dataset.tab!)));

  document.querySelectorAll<HTMLElement>('[data-tab-link]').forEach(el => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      activate(el.dataset.tabLink!);
    });
  });

  const initial = location.hash.startsWith('#tab-') ? location.hash.replace('#tab-', '') : null;
  if (initial && tabs.some(t => t.dataset.tab === initial)) {
    activate(initial, false);
  }
})();
</script>

<script>
// ---------------------------------------------------------------
// Scroll reveal — plays once, triggers as soon as an element starts
// entering the viewport, gentle fade/slide only.
// ---------------------------------------------------------------
(function () {
  const STAGGER = 60;
  const BASE_DELAYS = [0, 90, 180, 270, 360];
  const gridStagger = new Map<Element, number>();

  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;

      let delay = 0;
      if (el.dataset.revealDelay !== undefined) {
        delay = BASE_DELAYS[+el.dataset.revealDelay] ?? 0;
      } else {
        const group = el.closest('.ob-feature-list, .sc-grid, #ob-mods-tbody');
        if (group) {
          const idx = gridStagger.get(group) ?? 0;
          gridStagger.set(group, idx + 1);
          delay = Math.min(idx * STAGGER, 300);
        }
      }

      el.style.transitionDelay = delay + 'ms';
      el.classList.add('sc-revealed');
      io.unobserve(el);
    });
  }, {
    threshold: 0,
    rootMargin: '0px 0px -2% 0px',
  });

  function observe(el: HTMLElement) {
    if (el.classList.contains('sc-revealed')) return;
    io.observe(el);
  }
  document.querySelectorAll<HTMLElement>('[data-reveal]').forEach(observe);
  (window as any).__obReveal = observe;
})();

</script>

<script define:vars={{ modDataJson }}>
// ---------------------------------------------------------------
// All-projects table: filter + sort
// ---------------------------------------------------------------
const MOD_DATA = JSON.parse(modDataJson);

(function(){
  const tbody = document.getElementById('ob-mods-tbody');
  const empty = document.getElementById('sc-empty');
  const sortEl = document.getElementById('sc-sort');
  const filterBtns = document.querySelectorAll('.sc-filter');
  const resetBtns  = document.querySelectorAll('.sc-reset-filter');
  if (!tbody) return;

  let activeFilter = 'all';
  let activeSort   = 'default';
  const TIER = { featured: 0, major: 1, minor: 2 };

  const DL_SVG  = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`;
  const EXT_SVG = `<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>`;
  const DOC_SVG = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`;

  function itemLabel(s) {
    const base = s.platform === 'curseforge' ? 'CurseForge' : 'Modrinth';
    return s.label ? `${base} (${s.label})` : base;
  }

  function buildPlatformBtn(sources) {
    if (!sources.length) return '';
    if (sources.length === 1) {
      const s = sources[0];
      return `<a href="${s.url}" target="_blank" rel="noopener" class="sc-card-minor-action sc-ma-${s.platform}" title="${itemLabel(s)}">${DL_SVG}</a>`;
    }
    const items = sources.map(s =>
      `<a href="${s.url}" target="_blank" rel="noopener" class="pb-item pb-item-${s.platform}">${itemLabel(s)}${EXT_SVG}</a>`
    ).join('');
    return `<div class="pb-drop"><button class="sc-card-minor-action pb-trigger" type="button" title="Download">${DL_SVG}</button><div class="pb-menu pb-menu-right">${items}</div></div>`;
  }

  function buildDocBtn(docsSlug) {
    if (!docsSlug) return '';
    return `<a href="/docs/${docsSlug}" class="sc-card-minor-action" title="Docs">${DOC_SVG}</a>`;
  }

  function fmtDateStr(d) {
    return new Date(d).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
  }

  function getDlHtml(modId) {
    return document.querySelector(`[data-mod-id="${modId}"] .dl-compact`)?.outerHTML ?? '';
  }

  function buildRow(mod) {
    const statusBadges = [
      mod.tier === 'featured' ? '<span class="sc-tag ob-tag-featured">featured</span>' : '',
      mod.isBeta  ? '<span class="sc-status beta">beta</span>' : '',
      mod.isAlpha ? '<span class="sc-status alpha">alpha</span>' : '',
    ].join('');

    const loaders = mod.loaders.map(l =>
      `<span class="sc-loader sc-loader-${l}">${l}</span>`
    ).join('');

    return `
      <tr data-mod-id="${mod.id}" data-loaders="${mod.loaders.join(',')}" data-platforms="${mod.sources.map(s => s.platform).join(',')}" data-date="${mod.releaseDate}" data-tier="${mod.tier}">
        <td class="ob-td-mod">
          <img src="${mod.icon}" alt="" class="ob-td-icon" loading="lazy" />
          <div class="ob-td-mod-info">
            <span class="ob-td-name">${mod.name}${statusBadges}</span>
            <span class="ob-td-tagline">${mod.tagline}</span>
          </div>
        </td>
        <td class="ob-td-loaders">${loaders}</td>
        <td class="ob-td-date">${fmtDateStr(mod.releaseDate)}</td>
        <td class="ob-td-dl">${getDlHtml(mod.id)}</td>
        <td class="ob-td-actions">${buildDocBtn(mod.docsSlug)}${buildPlatformBtn(mod.sources)}</td>
      </tr>
    `;
  }

  function matches(mod) {
    if (activeFilter === 'all') return true;
    return mod.loaders.includes(activeFilter) || mod.sources.some(s => s.platform === activeFilter);
  }

  function render() {
    let mods = MOD_DATA.filter(matches);

    mods = [...mods].sort((a, b) => {
      if (activeSort === 'date-desc') return b.releaseDate > a.releaseDate ? 1 : -1;
      if (activeSort === 'date-asc')  return a.releaseDate > b.releaseDate ? 1 : -1;
      if (activeSort === 'name')      return a.name.localeCompare(b.name);
      if (activeSort === 'downloads') {
        const dl = id => {
          const el = document.querySelector(`[data-mod-id="${id}"] .dl-compact`);
          const t = el?.textContent?.trim() || '0';
          const n = parseFloat(t);
          return t.endsWith('M') ? n*1e6 : t.endsWith('K') ? n*1e3 : n;
        };
        return dl(b.id) - dl(a.id);
      }
      return TIER[a.tier] - TIER[b.tier];
    });

    tbody.innerHTML = mods.map(buildRow).join('');
    if (empty) empty.hidden = mods.length !== 0;
  }

  filterBtns.forEach(b => b.addEventListener('click', () => {
    activeFilter = b.dataset.filter;
    filterBtns.forEach(x => x.classList.toggle('active', x.dataset.filter === activeFilter));
    render();
  }));
  resetBtns.forEach(b => b.addEventListener('click', () => {
    activeFilter = 'all';
    filterBtns.forEach(x => x.classList.toggle('active', x.dataset.filter === 'all'));
    render();
  }));
  sortEl?.addEventListener('change', () => {
    activeSort = sortEl.value;
    render();
  });
})();
</script>

<script>
(async () => {
  function fmt(n: number) {
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
    if (n >= 1_000)     return (n / 1_000).toFixed(1).replace(/\.0$/, '') + 'K';
    return n.toLocaleString();
  }
  async function fetchCF(id: any) {
    try { const r = await fetch(`https://api.cfwidget.com/${id}`); if (!r.ok) return 0; const j = await r.json(); return j?.downloads?.total ?? j?.download_count ?? 0; } catch { return 0; }
  }
  async function fetchMR(id: any) {
    try { const r = await fetch(`https://api.modrinth.com/v2/project/${id}`, { headers: { 'User-Agent': 'obscurialithium/obscuria-collection-site' } }); if (!r.ok) return 0; const j = await r.json(); return j?.downloads ?? 0; } catch { return 0; }
  }
  const el = document.querySelector('.sc-stat-dl');
  if (!el) return;
  el.classList.add('dl-loading');
  const cfIds = (el.dataset.cf || '').split(',').filter(Boolean);
  const mrIds = (el.dataset.mr || '').split(',').filter(Boolean);
  const [cfRes, mrRes] = await Promise.all([Promise.all(cfIds.map(fetchCF)), Promise.all(mrIds.map(fetchMR))]);
  const total = [...cfRes, ...mrRes].reduce((a, b) => a + b, 0);
  el.textContent = total > 0 ? fmt(total) : '—';
  el.classList.remove('dl-loading');
})();
</script>

