<script>
(async () => {
  const el = document.getElementById('discord-online-count');
  if (!el) return;
  try {
    const res = await fetch('https://discord.com/api/invites/jSHHJSUWdY?with_counts=true');
    if (!res.ok) return;
    const data = await res.json();
    const count = data.approximate_member_count;
