---
// Search trigger button — the modal itself is rendered at body level in Layout.astro
// so it escapes the sidebar's overflow clipping
---

<button id="search-trigger" class="search-trigger" aria-label="Search docs (Ctrl+K)">
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
  <span class="search-trigger-text">Search docs…</span>
  <kbd class="search-trigger-kbd">⌘K</kbd>
</button>
