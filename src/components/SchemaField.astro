---
interface Props {
  name: string;
  type: string;
  optional?: boolean;
  required?: boolean;
  depth?: number;
}

const { name, type, optional = false, required = false, depth = 0 } = Astro.props;

const qualifier = required ? 'Required' : optional ? 'Optional' : null;
---

<div
  class="sf-row"
  data-schema-field={name}
  style={depth > 0 ? `--sf-depth: ${depth}` : undefined}
  role="row"
  tabindex="0"
  aria-label={`Field ${name}, type ${type}${qualifier ? `, ${qualifier}` : ''}`}
>
  <div class="sf-cell sf-name-cell">
    {depth > 0 && (
      <span class="sf-indent-guide" aria-hidden="true">
        {Array.from({ length: depth }).map(() => (
          <span class="sf-indent-line"></span>
        ))}
        <span class="sf-indent-corner"></span>
      </span>
    )}
    <code class="sf-badge">{name}</code>
  </div>

  <div class="sf-cell sf-type-cell">
    <span class="sf-type">{type}</span>
    {qualifier && <span class="sf-qualifier">{qualifier}</span>}
  </div>

  <div class="sf-cell sf-desc-cell">
    <slot />
  </div>
</div>

<style>
.sf-row {
  display: grid;
  grid-template-columns: 38% 22% 1fr;
  border-bottom: 1px solid var(--border);
  transition: background 0.12s ease;
  cursor: pointer;
  outline: none;
  --sf-depth: 0;
}
.sf-row:last-child { border-bottom: none; }
.sf-row:hover    { background: var(--hover); }
.sf-row:focus-visible { background: var(--hover); box-shadow: inset 2px 0 0 var(--acc); }
.sf-row:global(.sb-highlighted) { background: var(--acc-soft); box-shadow: inset 2px 0 0 var(--acc); }

.sf-cell {
  padding: 0.6rem 1.1rem;
  font-family: var(--font);
  font-size: var(--fs-sm);
  line-height: var(--lh-snug);
}

/* Field name */
.sf-name-cell {
  display: flex;
  align-items: flex-start;
  gap: 0;
}

/* indent guides for nested fields */
.sf-indent-guide {
  display: flex;
  align-items: flex-start;
  flex-shrink: 0;
  margin-right: 0.35rem;
  padding-top: 0.15rem;
}
.sf-indent-line {
  width: 1px;
  align-self: stretch;
  background: var(--surface-3);
  margin-right: 12px;
  flex-shrink: 0;
}
.sf-indent-corner {
  width: 8px;
  height: 10px;
  border-left: 1px solid var(--surface-3);
  border-bottom: 1px solid var(--surface-3);
  border-radius: 0 0 0 3px;
  margin-right: 6px;
  flex-shrink: 0;
}

.sf-badge {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: var(--fs-xs);
  background: var(--surface-2);
  border-radius: 4px;
  padding: 0.08em 0.52em;
  color: var(--txt-head);
  word-break: break-all;
  line-height: var(--lh-snug);
}

/* Type */
.sf-type-cell {
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}
.sf-type {
  font-weight: 600;
  color: var(--txt-head);
  font-size: var(--fs-sm);
}
.sf-qualifier {
  font-size: var(--fs-xs);
  color: var(--txt-muted);
  font-weight: 400;
}

/* Description */
.sf-desc-cell {
  color: var(--txt-muted);
  font-size: var(--fs-sm);
}
.sf-desc-cell :global(code) {
  font-family: var(--font-mono);
  font-size: 0.82em;
  background: var(--surface-2);
  color: var(--txt-head);
  padding: 0.1em 0.45em;
  border-radius: 4px;
}
.sf-desc-cell :global(strong) {
  color: var(--txt-head);
  font-weight: 600;
}
</style>
