---
interface Props {
  label?: string;
  file?: string;
}

const { label, file } = Astro.props;
---

<div class="cb-root">
  <div class="cb-bar">
    <span class="cb-dots" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>

    {file ? (
      <span class="cb-file">
        <svg class="cb-file-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
        {file}
      </span>
    ) : label ? (
      <span class="cb-lang">{label}</span>
    ) : null}

    <button class="cb-copy" aria-label="Copy code" data-cb-copy>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2"/>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
      </svg>
    </button>
  </div>

  <div class="cb-body" data-cb-body>
    <slot />
  </div>
</div>

<style>
.cb-root {
    margin: var(--space-3) 0 var(--space-6);
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--code-bg);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .cb-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3) var(--space-2) var(--space-4);
    background: var(--surface-2);
  }
  .cb-dots { display: flex; gap: 5px; flex-shrink: 0; margin-right: var(--space-2); }
  .cb-dots span { width: 7px; height: 7px; border-radius: 50%; background: var(--txt-subtle); }

  .cb-file,
  .cb-lang {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: 1;
    font-size: var(--fs-xs);
    color: var(--txt-muted);
  }
  .cb-file { max-width: max-content; }
  .cb-file-icon { flex-shrink: 0; color: var(--txt-subtle); }

  .cb-copy {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    margin-left: auto;
    flex-shrink: 0;
    border: none;
    border-radius: 6px;
    background: var(--surface-3);
    color: var(--txt-muted);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .cb-copy:hover { background: var(--acc-soft); color: var(--acc-text); }
  .cb-copy.copied { background: var(--ok-soft); color: var(--ok); }

  .cb-body { padding: var(--space-3) 0; overflow-x: auto; }
  .cb-body :global(pre) {
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    background: none !important;
    box-shadow: none !important;
    overflow: visible !important;
    font-size: inherit;
    line-height: 1.6;
  }
  .cb-body :global(pre code) {
    display: block;
    padding: 0 !important;
    background: none !important;
    counter-reset: line;
    white-space: pre;
    line-height: 0;
    font-size: var(--fs-sm);
  }
  .cb-body :global(.line) {
    position: relative;
    display: block;
    padding-right: var(--space-5);
    white-space: pre;
    line-height: 1.6;
    font-size: var(--fs-sm);
    transition: background 0.1s;
  }
  .cb-body :global(.line:empty::after),
  .cb-body :global(.line:not(:has(*)):not(:has(span))::after) { content: ' '; }
  .cb-body :global(.line:last-child:empty),
  .cb-body :global(.line:last-child:not(:has(span))) { display: none; }
  .cb-body :global(.line:hover) { background: var(--hover); }
  .cb-body :global(.line::before) {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 2.8rem;
    padding-right: var(--space-4);
    text-align: right;
    color: var(--txt-subtle);
    user-select: none;
    font-size: 0.82em;
    line-height: calc(1.6 / 0.82);
    vertical-align: baseline;
  }
</style>

<script>
  document.querySelectorAll('[data-cb-copy]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const body = btn.closest('.cb-root')?.querySelector('[data-cb-body]') as HTMLElement | null;
      if (!body) return;

      const lines = Array.from(body.querySelectorAll<HTMLElement>('.line'))
        .map(line => line.innerText)
        .join('\n');

      try {
        await navigator.clipboard.writeText(lines);

        btn.classList.add('copied');
        btn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;

        setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
        }, 1800);
      } catch {}
    });
  });
</script>