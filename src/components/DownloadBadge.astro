---
// DownloadBadge.astro
// Counts are fetched CLIENT-SIDE on every page load:
//   CurseForge → api.cfwidget.com  (public CORS proxy, no key needed)
//   Modrinth   → api.modrinth.com  (native CORS support, no key needed)

import type { ModSource } from '../data/mods';

interface Props {
  sources?: ModSource[];
  compact?: boolean;
}

const { sources = [], compact = false } = Astro.props;

// Serialize sources into data attributes for the client script
const cfIds = sources.filter(s => s.platform === 'curseforge').map(s => s.id).join(',');
const mrIds = sources.filter(s => s.platform === 'modrinth').map(s => s.id).join(',');
const uid   = Math.random().toString(36).slice(2); // unique per instance
---

<span
  class={`dl-root${compact ? ' dl-root-compact' : ''}`}
  data-cf={cfIds}
  data-mr={mrIds}
  data-uid={uid}
  data-compact={compact ? 'true' : 'false'}
></span>

<script>
(async function () {
  function fmt(n: number): string {
    if (n >= 1_000_000) return (n / 1_000_000).toFixed(1).replace(/\.0$/, '') + 'M';
    if (n >= 1_000)     return (n / 1_000).toFixed(1).replace(/\.0$/, '') + 'K';
    return n.toLocaleString();
  }

  async function fetchCF(id: string): Promise<number> {
    try {
      const r = await fetch(`https://api.cfwidget.com/${id}`);
      if (!r.ok) return 0;
      const j = await r.json();
      // cfwidget returns { downloads: { total: number } }
      return j?.downloads?.total ?? j?.download_count ?? 0;
    } catch { return 0; }
  }

  async function fetchMR(id: string): Promise<number> {
    try {
      const r = await fetch(`https://api.modrinth.com/v2/project/${id}`, {
        headers: { 'User-Agent': 'obscurialithium/obscuria-collection-site' }
      });
      if (!r.ok) return 0;
      const j = await r.json();
      return j?.downloads ?? 0;
    } catch { return 0; }
  }

  // CurseForge logo SVG (official, viewBox 0 0 24 24)
  const cfIcon = `<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m6.307 5.581.391 1.675H0s.112.502.167.558c.168.279.335.614.559.837 1.06 1.228 2.902 1.73 4.409 2.009 1.06.224 2.121.28 3.181.335l1.228 3.293h.67l.391 1.061h-.558l-.949 3.07h9.321l-.949-3.07h-.558l.39-1.061h.67s.558-3.404 2.288-4.967C21.935 7.758 24 7.535 24 7.535V5.581H6.307zm9.377 8.428c-.447.279-.949.279-1.284.503-.223.111-.335.446-.335.446-.223-.502-.502-.67-.837-.781-.335-.112-.949-.056-1.786-.782-.558-.502-.614-1.172-.558-1.507v-.167c0-.056 0-.112.056-.168.111-.334.39-.669.948-.893 0 0-.39.559 0 1.117.224.335.67.502 1.061.279.167-.112.279-.335.335-.503.111-.39.111-.781-.224-1.06-.502-.446-.613-1.06-.279-1.451 0 0 .112.502.614.446.335 0 .335-.111.224-.223-.056-.167-.782-1.228.279-2.009 0 0 .669-.447 1.451-.391-.447.056-.949.335-1.116.782v.055c-.168.447-.056.949.279 1.396.223.335.502.614.614 1.06-.168-.056-.279 0-.391.112a.533.533 0 0 0-.112.502c.056.112.168.223.279.223h.168c.167-.055.279-.279.223-.446.112.111.167.391.112.558 0 .167-.112.335-.168.446-.056.112-.167.224-.223.335-.056.112-.112.224-.112.335 0 .112 0 .279.056.391.223.335.67 0 .782-.279.167-.335.111-.726-.112-1.061 0 0 .391.224.67 1.005.223.67-.168 1.451-.614 1.73z"/></svg>`;

  // Modrinth logo SVG (official, viewBox 0 0 512 514)
  const mrIcon = `<svg width="13" height="13" viewBox="0 0 512 514" fill="currentColor" aria-hidden="true"><path d="M503.16,323.56C514.55,281.47 515.32,235.91 503.2,190.76C466.57,54.23 326.04,-26.8 189.33,9.78C83.81,38.02 11.39,128.07 0.69,230.47L43.99,230.47C54.29,147.33 113.74,74.73 199.75,51.71C306.05,23.26 415.13,80.67 453.17,181.38L411.03,192.65C391.64,145.8 352.57,111.45 306.3,96.82L298.56,140.66C335.09,154.13 364.72,184.5 375.56,224.91C391.36,283.8 361.94,344.14 308.56,369.17L320.09,412.16C390.25,383.21 432.4,310.3 422.43,235.14L464.41,223.91C468.816,251.936 467.503,280.565 460.55,308.07L503.16,323.56Z"/><path d="M321.99,504.22C185.27,540.8 44.75,459.77 8.11,323.24C3.911,307.604 1.196,291.606 -0,275.46L43.27,275.46C44.36,287.37 46.47,299.35 49.68,311.29C53.04,323.8 57.45,335.75 62.79,347.07L101.38,323.92C98.13,316.42 95.39,308.6 93.21,300.47C69.17,210.87 122.41,118.77 212.13,94.76C229.13,90.21 246.23,88.44 262.93,89.15L255.19,133C244.73,133.05 234.11,134.42 223.53,137.25C157.31,154.98 118.01,222.95 135.75,289.09C136.85,293.16 138.13,297.13 139.59,300.99L188.94,271.38L174.07,231.95L220.67,184.08L279.57,171.39L296.62,192.38L269.47,219.88L245.79,227.33L228.87,244.72L237.16,267.79C237.16,267.79 253.95,285.63 253.98,285.64L277.7,279.33L294.58,260.79L331.44,249.12L342.42,273.82L304.39,320.45L240.66,340.63L212.08,308.81L162.26,338.7C187.8,367.78 226.2,383.93 266.01,380.56L277.54,423.55C218.13,431.41 160.1,406.82 124.05,361.64L85.64,384.68C136.25,451.17 223.84,484.11 309.61,461.16C371.35,444.64 419.4,402.56 445.42,349.38L488.06,364.88C457.17,431.16 398.22,483.82 321.99,504.22"/></svg>`;

  // Generic download icon for total badge
  const dlIcon = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>`;

  function render(root: HTMLElement, cfTotal: number, mrTotal: number) {
    const total   = cfTotal + mrTotal;
    const compact = root.dataset.compact === 'true';

    if (compact) {
      if (total === 0) { root.innerHTML = ''; return; }
      root.innerHTML = `
        <span class="dl-compact" title="CurseForge: ${fmt(cfTotal)} · Modrinth: ${fmt(mrTotal)}">
          ${dlIcon}
          ${fmt(total)}
        </span>`;
      return;
    }

    if (cfTotal === 0 && mrTotal === 0) { root.innerHTML = ''; return; }

    const totalBadge = total > 0 ? `
      <span class="dl-badge dl-total">
        ${dlIcon}
        ${fmt(total)}
      </span>` : '';

    const cfBadge = cfTotal > 0 ? `
      <span class="dl-badge dl-cf" data-tooltip="CurseForge" aria-label="CurseForge: ${fmt(cfTotal)}">
        ${cfIcon}
        ${fmt(cfTotal)}
      </span>` : '';

    const mrBadge = mrTotal > 0 ? `
      <span class="dl-badge dl-mr" data-tooltip="Modrinth" aria-label="Modrinth: ${fmt(mrTotal)}">
        ${mrIcon}
        ${fmt(mrTotal)}
      </span>` : '';

    root.innerHTML = `<div class="dl-badges">${totalBadge}${cfBadge}${mrBadge}</div>`;
  }

  // Process every badge root on the page
  document.querySelectorAll<HTMLElement>('.dl-root').forEach(async root => {
    const cfIds = (root.dataset.cf || '').split(',').filter(Boolean);
    const mrIds = (root.dataset.mr || '').split(',').filter(Boolean);

    // Fetch all in parallel, render as totals come in
    const [cfResults, mrResults] = await Promise.all([
      Promise.all(cfIds.map(fetchCF)),
      Promise.all(mrIds.map(fetchMR)),
    ]);

    const cfTotal = cfResults.reduce((a, b) => a + b, 0);
    const mrTotal = mrResults.reduce((a, b) => a + b, 0);
    render(root, cfTotal, mrTotal);
  });
})();
</script>

<style is:global>
.dl-root { display: contents; }

.dl-compact {
  display: inline-flex;
  align-items: center;
  gap: 0.3em;
  font-size: 0.78rem;
  font-weight: 500;
  color: var(--txt-muted);
}
.dl-badges {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.4rem;
}
.dl-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.3em;
  font-size: 0.72rem;
  font-weight: 600;
  padding: 0.18em 0.6em;
  border-radius: 4px;
  letter-spacing: 0.03em;
}
.dl-total {
  background: rgba(168,127,212,0.12);
  color: var(--acc);
  border: 1px solid rgba(168,127,212,0.2);
}
.dl-cf {
  background: rgba(245,130,32,0.1);
  color: #f08030;
  border: 1px solid rgba(245,130,32,0.2);
}
.dl-mr {
  background: rgba(27,217,106,0.08);
  color: #1bd96a;
  border: 1px solid rgba(27,217,106,0.18);
}

/* CSS tooltip */
.dl-badge[data-tooltip] {
  position: relative;
}
.dl-badge[data-tooltip]::after {
  content: attr(data-tooltip);
  position: absolute;
  bottom: calc(100% + 6px);
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  padding: 0.2em 0.55em;
  border-radius: 4px;
  background: rgba(20, 18, 28, 0.92);
  color: #e8e0f0;
  border: 1px solid rgba(255,255,255,0.08);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.15s ease;
  z-index: 10;
}
.dl-badge[data-tooltip]:hover::after {
  opacity: 1;
}
</style>
