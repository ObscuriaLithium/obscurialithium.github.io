---
// Horizontal screenshot strip. Mouse wheel scrolls it sideways until an edge is reached.
import type { ModGalleryImage } from '../data/mods';

interface Props { images: ModGalleryImage[]; }
const { images } = Astro.props;
---

<div class="mod-gallery" data-gallery tabindex="0" role="group" aria-label="Screenshots">
  {images.map(img => {
    const Tag = img.href ? 'a' : 'figure';
    return (
      <Tag class:list={['mod-gallery-item', { 'is-video': img.href }]} {...(img.href ? { href: img.href, target: '_blank', rel: 'noopener', 'aria-label': img.alt } : {})}>
        <img src={img.src} alt={img.href ? '' : img.alt} loading="lazy" />
        {img.href && <span class="mod-gallery-play" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20"/></svg></span>}
        {img.caption && <span class="mod-gallery-caption">{img.caption}</span>}
      </Tag>
    );
  })}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(el => {
    el.addEventListener('wheel', e => {
      if (el.scrollWidth <= el.clientWidth || Math.abs(e.deltaY) < Math.abs(e.deltaX)) return;
      const atStart = el.scrollLeft <= 0 && e.deltaY < 0;
      const atEnd = el.scrollLeft + el.clientWidth >= el.scrollWidth - 1 && e.deltaY > 0;
      if (atStart || atEnd) return;
      e.preventDefault();
      el.scrollBy({ left: e.deltaY, behavior: 'auto' });
    }, { passive: false });
  });
</script>

<style is:global>
.mod-gallery{display:flex;gap:var(--space-4);overflow-x:auto;scroll-snap-type:x proximity;scrollbar-width:thin;scrollbar-color:var(--surface-3) transparent}
.mod-gallery-item{position:relative;display:block;flex:none;margin:0;overflow:hidden;border-radius:var(--radius);scroll-snap-align:start;background:var(--surface-3)}
.mod-gallery-item img{display:block;height:240px;width:auto;min-width:200px;max-width:min(80vw,560px);object-fit:cover}
.mod-gallery-caption{position:absolute;left:0;right:0;bottom:0;padding:var(--space-5) var(--space-3) var(--space-2);background:linear-gradient(transparent,rgba(var(--surface-rgb),.85));font-size:var(--fs-xs);color:var(--txt-head)}
.mod-gallery-play{position:absolute;top:50%;left:50%;display:grid;place-items:center;width:52px;height:52px;border-radius:50%;background:var(--acc);color:var(--on-acc);transform:translate(-50%,-50%);transition:background .15s var(--ease)}
.mod-gallery-item.is-video img{aspect-ratio:16/9}
.mod-gallery-item.is-video:hover .mod-gallery-play{background:var(--acc-hover)}
@media (max-width:560px){.mod-gallery-item img{height:170px}}
</style>
