---
// Header slideshow: crossfades on its own, pauses while hovered or focused, arrows and dots for manual control.
import type { ModGalleryImage } from '../data/mods';

interface Props { images: ModGalleryImage[]; }
const { images } = Astro.props;
const multi = images.length > 1;
---

<div class="mod-gallery" data-gallery tabindex="0" role="group" aria-roledescription="carousel" aria-label="Screenshots">
  <div class="mod-gallery-track">
    {images.map((img, i) => {
      const Tag = img.href ? 'a' : 'figure';
      return (
        <Tag class:list={['mod-gallery-slide', { 'is-active': i === 0, 'is-video': img.href }]} data-slide aria-hidden={i === 0 ? 'false' : 'true'} {...(img.href ? { href: img.href, target: '_blank', rel: 'noopener', 'aria-label': img.alt, tabindex: i === 0 ? 0 : -1 } : {})}>
          <img src={img.src} alt={img.href ? '' : img.alt} loading={i === 0 ? 'eager' : 'lazy'} draggable="false" />
          {img.href && <span class="mod-gallery-play" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20"/></svg></span>}
          {img.caption && <span class="mod-gallery-caption">{img.caption}</span>}
        </Tag>
      );
    })}
  </div>

  {multi && (
    <>
      <button type="button" class="mod-gallery-nav mod-gallery-nav--prev" data-prev aria-label="Previous image">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button type="button" class="mod-gallery-nav mod-gallery-nav--next" data-next aria-label="Next image">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
      <div class="mod-gallery-dots">
        {images.map((_, i) => (
          <button type="button" class:list={['mod-gallery-dot', { 'is-active': i === 0 }]} data-dot={i} aria-label={`Image ${i + 1} of ${images.length}`} aria-current={i === 0 ? 'true' : undefined}></button>
        ))}
      </div>
    </>
  )}
</div>

<script>
  const INTERVAL = 5000;
  const SWIPE = 40;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(root => {
    const seen = new IntersectionObserver(([entry]) => {
      root.classList.toggle('is-live', entry.isIntersecting);
    }, { threshold: 0.35 });
    seen.observe(root);

    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    if (slides.length < 2) return;
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];

    let index = 0;
    let timer = 0;
    let hovered = false;
    let visible = false;
    let startX: number | null = null;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === index;
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-hidden', String(!on));
        if (s instanceof HTMLAnchorElement) s.tabIndex = on ? 0 : -1;
      });
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === index);
        if (i === index) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current');
      });
    };

    const stop = () => { clearTimeout(timer); timer = 0; };
    const play = () => {
      stop();
      if (reduced || hovered || !visible) return;
      timer = window.setTimeout(() => { show(index + 1); play(); }, INTERVAL);
    };
    const go = (next: number) => { show(next); play(); };

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));

    root.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') { hovered = true; stop(); } });
    root.addEventListener('pointerleave', e => { if (e.pointerType === 'mouse') { hovered = false; play(); } });
    root.addEventListener('focusin', () => { hovered = true; stop(); });
    root.addEventListener('focusout', () => { hovered = root.matches(':hover'); play(); });

    root.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); go(index + 1); }
    });

    root.addEventListener('pointerdown', e => { if (e.pointerType !== 'mouse') startX = e.clientX; });
    root.addEventListener('pointerup', e => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) >= SWIPE) go(index + (dx < 0 ? 1 : -1));
    });
    root.addEventListener('pointercancel', () => { startX = null; });

    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; play(); }, { threshold: 0.35 }).observe(root);
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else play(); });
  });
</script>

<style is:global>
.mod-gallery{position:relative;overflow:hidden;background:var(--surface-3);outline-offset:-2px}
.mod-gallery-track{position:relative;aspect-ratio:21/9;max-height:460px;width:100%}
.mod-gallery-slide{position:absolute;inset:0;display:block;margin:0;overflow:hidden;opacity:0;visibility:hidden;transition:opacity .7s var(--ease),visibility 0s .7s}
.mod-gallery-slide.is-active{opacity:1;visibility:visible;transition:opacity .7s var(--ease),visibility 0s}
.mod-gallery-slide img{display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.22);transition:transform 0s .7s}
.mod-gallery.is-live .mod-gallery-slide.is-active img{transform:scale(1);transition:transform 7s cubic-bezier(.25,.1,.25,1)}
.mod-gallery-slide::after{content:"";position:absolute;inset:auto 0 0;height:45%;background:linear-gradient(transparent,rgba(var(--surface-rgb),.8));pointer-events:none}
.mod-gallery-caption{position:absolute;left:var(--space-5);bottom:var(--space-6);z-index:1;font-size:var(--fs-xs);font-weight:600;color:var(--txt-head)}
.mod-gallery-play{position:absolute;top:50%;left:50%;z-index:1;display:grid;place-items:center;width:64px;height:64px;border-radius:50%;background:var(--acc);color:var(--on-acc);transform:translate(-50%,-50%);transition:background .15s var(--ease),transform .2s var(--ease)}
.mod-gallery-slide.is-video:hover .mod-gallery-play{background:var(--acc-hover);transform:translate(-50%,-50%) scale(1.08)}

.mod-gallery-nav{position:absolute;top:50%;z-index:2;display:grid;place-items:center;width:42px;height:42px;padding:0;border:0;border-radius:50%;background:rgba(var(--surface-rgb),.7);color:var(--txt-head);backdrop-filter:blur(6px);cursor:pointer;opacity:0;transform:translateY(-50%);transition:opacity .2s var(--ease),background .15s var(--ease),color .15s var(--ease)}
.mod-gallery-nav--prev{left:var(--space-4)}
.mod-gallery-nav--next{right:var(--space-4)}
.mod-gallery:hover .mod-gallery-nav,.mod-gallery:focus-within .mod-gallery-nav{opacity:1}
.mod-gallery-nav:hover{background:var(--acc);color:var(--on-acc)}
.mod-gallery-nav:focus-visible,.mod-gallery-dot:focus-visible{outline:2px solid var(--acc-text);outline-offset:2px}

.mod-gallery-dots{position:absolute;left:0;right:0;bottom:var(--space-4);z-index:2;display:flex;justify-content:center;gap:var(--space-2);pointer-events:none}
.mod-gallery-dot{position:relative;width:8px;height:8px;padding:0;border:0;border-radius:99px;background:var(--txt-subtle);opacity:.7;cursor:pointer;pointer-events:auto;transition:width .3s var(--ease),background .2s var(--ease),opacity .2s var(--ease)}
.mod-gallery-dot::before{content:"";position:absolute;inset:-8px -3px}
.mod-gallery-dot:hover{opacity:1}
.mod-gallery-dot.is-active{width:24px;background:var(--acc);opacity:1}

@media (hover:none){.mod-gallery-nav{opacity:1}}
@media (max-width:600px){
  .mod-gallery-track{aspect-ratio:16/10}
  .mod-gallery-nav{width:36px;height:36px}
  .mod-gallery-nav--prev{left:var(--space-3)}
  .mod-gallery-nav--next{right:var(--space-3)}
  .mod-gallery-caption{left:var(--space-4)}
}
@media (prefers-reduced-motion:reduce){
  .mod-gallery-slide,.mod-gallery-slide.is-active{transition:none}
  .mod-gallery-slide img,.mod-gallery.is-live .mod-gallery-slide.is-active img{transform:none;transition:none}
}
</style>
